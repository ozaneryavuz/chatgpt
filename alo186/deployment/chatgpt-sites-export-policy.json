  "priorityRoutePrefixes": [
    "/il/",
    "/dagitim-sirketleri/",
    "/hesaplama/",
    "/haberler/",
    "/amazon-elektrik-urunleri/",
    "/hizmetler/",
    "/sektor-rehberi/",
