    "trafo",
    "jenerator",
    "pano",
    "harmonik",
    "kompanzasyon",
    "orta-gerilim",
    "og-",
    "ges",
    "ev-sarj",
    "topraklama",
    "yildirim",
    "busbar",
    "kisa-devre",
    "secicilik",
    "proje",
    "ihale"
  ],
  "trustRules": {
    "officialInstitutionImpression": false,
    "collectOutageReports": false,
    "collectPersonalData": false,
    "emergencyCommerceClosed": true,
    "amazonTurkeyOnly": true,
    "affiliateDisclosureBeforeLink": true,
    "affiliateRelRequired": [
      "sponsored",
      "nofollow",
      "noopener"
    ],
    "unverifiedCommercialFieldsForbidden": [
      "price",
      "stock",
      "availability",
      "rating",
      "aggregateRating",
      "review",
      "warranty",
      "delivery"
    ],
    "noBuyOutcomeRequired": true,
    "productSchemaWithoutVerifiedOffer": "generic-class-only"
  },
  "migrationRules": {
    "preserveCanonicalPaths": true,
    "excludeDeclaredAliases": true,
    "preserveNativeSitesDesignSystem": true,
    "blindStaticCssOverwriteAllowed": false,
    "preferNativeSitesPagesForStaticContent": true,
    "preferSitesInteractiveAppsForTools": true,
    "keepServerRenderedFallback": true,
    "copyStructuredData": true,
    "copyLocalAssets": true,
    "publishedAiCmsOnly": true,
    "doNotCopyGitHubWorkflows": true,
    "doNotCopyDeploymentScripts": true,
    "doNotCopyTestsOrReports": true,
    "doNotChangeDns": true,
    "doNotAttachCustomDomainToGitHubPages": true,
    "undocumentedSitesApiAllowed": false
  }
}
