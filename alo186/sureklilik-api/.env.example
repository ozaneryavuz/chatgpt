# Ortam: development | test | staging | production
ALO186_ENV=development
ALO186_DATABASE_URL=postgresql+psycopg://alo186:change-me@db:5432/alo186

# Secret değerleri doğrudan veya Docker/Kubernetes secret dosyasıyla verilebilir:
# ALO186_TOKEN_SECRET_FILE=/run/secrets/alo186_token_secret
ALO186_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Üretmek için: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALO186_DATA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
ALO186_TOKEN_TTL_SECONDS=28800
ALO186_EMAIL_TOKEN_TTL_SECONDS=86400
ALO186_PASSWORD_RESET_TTL_SECONDS=3600
ALO186_INVITATION_TTL_SECONDS=604800

ALO186_ALLOWED_ORIGINS=https://www.alo186.com
ALO186_ALLOWED_HOSTS=api.alo186.com,localhost,127.0.0.1,testserver
ALO186_PUBLIC_BASE_URL=https://www.alo186.com
ALO186_AUTO_CREATE_SCHEMA=false
ALO186_RUN_MIGRATIONS=true

# Production ortamında true ve SMTP backend zorunludur.
ALO186_EMAIL_VERIFICATION_REQUIRED=false
ALO186_EXPOSE_TEST_TOKENS=false
ALO186_EMAIL_BACKEND=console
ALO186_SMTP_HOST=
ALO186_SMTP_PORT=587
ALO186_SMTP_USERNAME=
# ALO186_SMTP_PASSWORD_FILE=/run/secrets/alo186_smtp_password
ALO186_SMTP_PASSWORD=
ALO186_SMTP_FROM_EMAIL=noreply@alo186.com
ALO186_SMTP_USE_TLS=true

ALO186_GLOBAL_RATE_LIMIT=240
ALO186_AUTH_RATE_LIMIT=10
ALO186_RATE_LIMIT_WINDOW_SECONDS=900
ALO186_MAX_REQUEST_BYTES=1048576
ALO186_TRUST_PROXY_HEADERS=false
ALO186_ACCOUNT_LOCK_THRESHOLD=5
ALO186_ACCOUNT_LOCK_SECONDS=900

ALO186_DELETION_GRACE_DAYS=30
ALO186_AUDIT_RETENTION_DAYS=730
ALO186_OUTBOX_RETENTION_DAYS=30
# ALO186_METRICS_TOKEN_FILE=/run/secrets/alo186_metrics_token
ALO186_METRICS_TOKEN=

ALO186_BACKUP_DIR=/backups
ALO186_BACKUP_RETENTION_DAYS=14
# Opsiyonel şifreli/offsite restic deposu:
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
