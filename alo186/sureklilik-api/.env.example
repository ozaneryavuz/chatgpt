# Ortam: development | test | staging | production
ALO186_ENV=development

# Veritabanı
ALO186_DATABASE_URL=postgresql+psycopg://alo186:change-me@db:5432/alo186
# Production secret'ları doğrudan değişken yerine Docker/Kubernetes secret dosyasından okuyabilirsiniz:
# ALO186_DATABASE_URL_FILE=/run/secrets/database_url

# Oturum imza secret'ı en az 32 rastgele karakter olmalı.
ALO186_TOKEN_SECRET=replace-with-at-least-32-random-characters
# ALO186_TOKEN_SECRET_FILE=/run/secrets/token_secret
ALO186_TOKEN_TTL_SECONDS=28800

# Ağ ve tarayıcı
ALO186_ALLOWED_ORIGINS=https://www.alo186.com
ALO186_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ALO186_TRUST_PROXY_HEADERS=false

# API koruması
ALO186_MAX_REQUEST_BODY_BYTES=1048576
ALO186_API_RATE_LIMIT_PER_MINUTE=120
ALO186_AUTH_RATE_LIMIT_PER_MINUTE=12

# Operasyon
ALO186_METRICS_ENABLED=true
ALO186_AUTO_CREATE_SCHEMA=true
ALO186_LOG_LEVEL=INFO

# Production örneği:
# ALO186_ENV=production
# ALO186_ALLOWED_HOSTS=api.alo186.com
# ALO186_AUTO_CREATE_SCHEMA=false
# ALO186_TOKEN_SECRET_FILE=/run/secrets/token_secret
# ALO186_DATABASE_URL_FILE=/run/secrets/database_url
