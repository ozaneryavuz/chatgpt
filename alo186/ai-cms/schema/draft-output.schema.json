{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alo186.com/schemas/ai-cms-draft-output-v1.json",
  "title": "ALO186 AI CMS Draft Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "h1",
    "description",
    "directAnswer",
    "sections",
    "faqs",
    "topics",
    "riskNotes"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 20, "maxLength": 68},
    "h1": {"type": "string", "minLength": 20, "maxLength": 110},
    "description": {"type": "string", "minLength": 110, "maxLength": 170},
    "directAnswer": {"type": "string", "minLength": 80, "maxLength": 650},
    "sections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "heading", "paragraphs", "bullets", "sourceRefs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "heading": {"type": "string", "minLength": 8, "maxLength": 120},
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {"type": "string", "minLength": 40, "maxLength": 1200}
          },
          "bullets": {
            "type": "array",
            "maxItems": 10,
            "items": {"type": "string", "minLength": 8, "maxLength": 260}
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^S[1-9][0-9]*$"}
          }
        }
      }
    },
    "faqs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer", "sourceRefs"],
        "properties": {
          "question": {"type": "string", "minLength": 12, "maxLength": 180},
          "answer": {"type": "string", "minLength": 40, "maxLength": 900},
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^S[1-9][0-9]*$"}
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2, "maxLength": 80}
    },
    "riskNotes": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string", "minLength": 12, "maxLength": 260}
    }
  }
}
