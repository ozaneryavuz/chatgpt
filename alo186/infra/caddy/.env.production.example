# Bu dosya yalnız Docker Compose config doğrulaması ve taşınabilir kurulum şablonudur.
# Gerçek production değerlerini .env.production içinde veya secret manager ile verin.
ALO186_ENV=production
ALO186_DATABASE_URL=postgresql+psycopg://alo186:replace-me@postgres:5432/alo186
ALO186_TOKEN_SECRET=replace-with-at-least-32-random-characters
ALO186_DATA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
ALO186_ALLOWED_ORIGINS=https://www.alo186.com
ALO186_ALLOWED_HOSTS=api.alo186.com,localhost,127.0.0.1
ALO186_PUBLIC_BASE_URL=https://www.alo186.com
ALO186_AUTO_CREATE_SCHEMA=false
ALO186_EMAIL_VERIFICATION_REQUIRED=true
ALO186_EMAIL_BACKEND=smtp
ALO186_SMTP_HOST=smtp.postmarkapp.com
ALO186_SMTP_PORT=587
ALO186_SMTP_USERNAME=replace-me
ALO186_SMTP_PASSWORD=replace-me
ALO186_SMTP_FROM_EMAIL=noreply@alo186.com
ALO186_METRICS_TOKEN=replace-me
