{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alo186.com/schemas/ai-cms-draft-v220.json",
  "title": "ALO186 AI CMS yayın taslağı",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "route",
    "title",
    "description",
    "h1",
    "directAnswer",
    "bodyHtml",
    "faqs",
    "jsonLd",
    "internalLinks",
    "sourceCitations",
    "cta",
    "analyticsEvents",
    "intentBoundary",
    "safetyBoundary",
    "verifiedAt"
  ],
  "properties": {
    "id": {"type": "string"},
    "route": {"type": "string"},
    "title": {"type": "string", "minLength": 20, "maxLength": 140},
    "description": {"type": "string", "minLength": 70, "maxLength": 190},
    "h1": {"type": "string", "minLength": 15, "maxLength": 150},
    "directAnswer": {"type": "string", "minLength": 120, "maxLength": 1200},
    "bodyHtml": {"type": "string", "minLength": 800},
    "faqs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer"],
        "properties": {
          "question": {"type": "string"},
          "answer": {"type": "string"}
        }
      }
    },
    "jsonLd": {"type": ["object", "array"]},
    "internalLinks": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "sourceCitations": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"type": "string"},
        "secondary": {"type": "string"}
      }
    },
    "analyticsEvents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "intentBoundary": {"type": "string", "minLength": 60},
    "safetyBoundary": {"type": "string", "minLength": 30},
    "verifiedAt": {"type": "string", "format": "date"}
  }
}
